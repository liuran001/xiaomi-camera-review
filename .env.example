# Initialize with tools/init_config.py, which generates fresh credentials.
# Edit RECORDINGS_PATH before starting. Linux bind paths must be absolute.
RECORDINGS_PATH=/path/to/xiaomi_camera_videos
APP_UID=1000
APP_GID=1000
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8090
APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=0

# Filename timestamps; the playback interface always displays Beijing time.
SOURCE_TZ=Asia/Shanghai
STABLE_SECONDS=180
COMPLETE_FILE_BYTES=0
SCAN_SECONDS=45
SAMPLE_SECONDS=3
ANALYSIS_CHUNK_SECONDS=60
EMPTY_SCENE_GATE=0
OPENCV_NUM_THREADS=1
PREVIEW_THREADS=1
